# ====== انسخ الملف ده لـ .env:  cp .env.example .env ======
# ولا عمرك تعمل commit لملف .env

# ---- قاعدة البيانات ----
POSTGRES_USER=freeai
POSTGRES_PASSWORD=غير-كلمة-السر-دي
POSTGRES_DB=freeai
TZ=Europe/Amsterdam

# ---- LiteLLM ----
# المفتاح اللي كل التطبيقات هتستخدمه (ابدأه بـ sk-)
LITELLM_MASTER_KEY=sk-local-master
# مهم جدًا: مفتاح تشفير مفاتيح المزودين — خليه ثابت وما تغيّرهوش بعد أول تشغيل
LITELLM_SALT_KEY=sk-local-salt-change-me
LITELLM_PORT=4000

# ---- n8n ----
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=غير-ال-24-حرف-دي

# ---- Open WebUI ----
WEBUI_PORT=3000
WEBUI_SECRET_KEY=غير-ال-دي-كمان

# ---- مفاتيح المزودين المجانية (حط واحد على الأقل) ----
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_NIM_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---- اختياري ----
OLLAMA_PORT=11434
